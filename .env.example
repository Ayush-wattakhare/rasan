# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Payment Gateway - Razorpay
# Test Mode: rzp_test_... | Live Mode: rzp_live_...
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Optional server copy of the key id (must be the SAME key as NEXT_PUBLIC_RAZORPAY_KEY_ID)
RAZORPAY_KEY_ID=rzp_test_your_key_id
# Configured in Razorpay Dashboard -> Settings -> Webhooks: https://your-domain.com/api/payments/webhook
# Events: payment.captured, order.paid, payment.failed, refund.processed, refund.failed
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Cash-on-delivery UPI QR shown by riders (Rasan's own collection VPA). QR is hidden if unset.
NEXT_PUBLIC_UPI_PAYEE_VPA=
NEXT_PUBLIC_UPI_PAYEE_NAME=Rasan

# Vercel Cron: cancels unpaid online orders (Authorization: Bearer <CRON_SECRET>)
CRON_SECRET=generate_a_long_random_string

# Shared rate limiting across server instances (Upstash Redis REST). Optional;
# without it, limits are per instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Local-only bootstrap tools (/admin/setup, /dev). Never enable in production.
ENABLE_DEV_TOOLS=false
ADMIN_SETUP_SECRET=

# Transactional SMS & WhatsApp (Optional - defaults to mock logger if unconfigured)
FAST2SMS_API_KEY=your_fast2sms_api_key
MSG91_AUTH_KEY=your_msg91_auth_key
MSG91_TEMPLATE_ID=your_msg91_flow_template_id
MSG91_SENDER_ID=RASANF
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
WHATSAPP_API_TOKEN=your_meta_whatsapp_cloud_token
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id

# Payment Gateway - Stripe (Secondary / International)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Maps API (Optional - for enhanced location features)
NEXT_PUBLIC_MAPS_API_KEY=your_maps_api_key

# Email Service (Optional - for notifications)
EMAIL_SERVICE_API_KEY=your_email_service_api_key

# Phone / SMS Auth (Configured in Supabase Dashboard → Auth → Providers → Phone)
# These variables are entered directly in the Supabase dashboard, NOT in this file.
# Supported providers: Twilio, MessageBird, Vonage, AWS SNS
#
# For Twilio (recommended):
#   TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#   TWILIO_MESSAGE_SERVICE_SID=MGxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# OTP settings to configure in Supabase dashboard:
#   OTP Expiry: 300 seconds (5 minutes)
#   OTP Length: 6 digits
#   Rate limit: 3 SMS per 10 minutes per phone number

# Monitoring (Optional - Sentry)
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
